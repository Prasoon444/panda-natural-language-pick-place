def Scope "Materials"
{
    def Material "m_trans__plastic__bottledWater_b01" (
        prepend apiSchemas = ["SemanticsLabelsAPI:material"]
    )
    {
        custom token[] omni:simready:nonvisual:attributes = ["visually_transparent"]
        custom token omni:simready:nonvisual:base = "plastic"
        custom token omni:simready:nonvisual:coating = "none"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:mdl:surface.connect = </Materials/m_trans__plastic__bottledWater_b01/OmniGlass_Shader.outputs:out>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/m_trans__plastic__bottledWater_b01/Principled_BSDF.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )
        custom int pxr:usd:physics_density = 950
        custom double pxr:usd:physics_dynamicFriction = 0.4
        custom double pxr:usd:physics_fillRatio = 0.6
        custom double pxr:usd:physics_restitution = 0.4
        custom double pxr:usd:physics_staticFriction = 0.4
        custom double pxr:usd:physics_thickness = 0.004
        custom string pxr:usd:physics_type = "plastic"
        token[] semantics:labels:material = ["plastic"]

        def Shader "Principled_BSDF" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            float inputs:clearcoat = 0
            float inputs:clearcoatRoughness = 0.03
            prepend color3f inputs:diffuseColor.connect = </Materials/m_trans__plastic__bottledWater_b01/Albedo.outputs:rgb>
            float inputs:ior = 1.5
            prepend float inputs:metallic.connect = </Materials/m_trans__plastic__bottledWater_b01/ORM.outputs:b>
            prepend normal3f inputs:normal.connect = </Materials/m_trans__plastic__bottledWater_b01/Normal.outputs:rgb>
            float inputs:opacity = 0.2
            prepend float inputs:roughness.connect = </Materials/m_trans__plastic__bottledWater_b01/ORM.outputs:g>
            float inputs:specular = 0.5
            token outputs:surface
        }

        def Shader "Albedo" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdUVTexture"
            asset inputs:file = @../Textures/t_bottledWater_white_b01_alb.png@
            token inputs:sourceColorSpace = "sRGB"
            prepend float2 inputs:st.connect = </Materials/m_trans__plastic__bottledWater_b01/uvmap.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }

        def Shader "uvmap" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }

        def Shader "ORM" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdUVTexture"
            asset inputs:file = @../Textures/t_bottledWater_white_b01_orm.png@
            token inputs:sourceColorSpace = "raw"
            prepend float2 inputs:st.connect = </Materials/m_trans__plastic__bottledWater_b01/uvmap.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float outputs:b
            float outputs:g
        }

        def Shader "Normal" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdUVTexture"
            float4 inputs:bias = (-1, -1, -1, -1)
            asset inputs:file = @../Textures/t_bottledWater_white_b01_nor.png@
            float4 inputs:scale = (2, 2, 2, 2)
            token inputs:sourceColorSpace = "raw"
            prepend float2 inputs:st.connect = </Materials/m_trans__plastic__bottledWater_b01/uvmap.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }

        def Shader "OmniGlass_Shader" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "mdl:OmniGlass"
            token info:implementationSource = "sourceAsset"
            asset info:mdl:sourceAsset = @../source_assets/OmniGlass.mdl@
            token info:mdl:sourceAsset:subIdentifier = "OmniGlass"
            float inputs:cutout_opacity = 0.2
            bool inputs:enable_ORM_texture = 1
            bool inputs:flip_tangent_u = 1
            bool inputs:flip_tangent_v = 0
            float inputs:frosting_roughness = 0.01
            asset inputs:glass_color_texture = @../Textures/t_bottledWater_white_b01_alb.png@ (
                colorSpace = "raw"
            )
            float inputs:glass_ior = 1.5
            float inputs:metallic_texture_influence = 1
            asset inputs:normal_map_texture = @../Textures/t_bottledWater_white_b01_nor.png@ (
                colorSpace = "raw"
            )
            asset inputs:ORM_texture = @../Textures/t_bottledWater_white_b01_orm.png@
            float inputs:reflection_roughness_texture_influence = 0
            token outputs:out
        }
    }

